<incoming-call-banner />
<view class="msg-page">
  <!-- 顶部蓝色区 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav">
      <view class="back" bindtap="onBack">←</view>
      <view class="nav-title">消息中心</view>
      <view class="read" bindtap="onReadAll">已读</view>
    </view>

    <!-- 一级 Tab -->
    <view class="top-tabs">
      <view
        class="top-tab {{topTab === 0 ? 'active' : ''}}"
        bindtap="switchTopTab"
        data-i="0"
      >消息</view>
      <view
        class="top-tab {{topTab === 1 ? 'active' : ''}}"
        bindtap="switchTopTab"
        data-i="1"
      >推送通知</view>
    </view>
  </view>

  <!-- 推送通知列表 -->
  <scroll-view class="msg-list" scroll-y>
    <block wx:for="{{pushList}}" wx:key="id">
      <view class="msg-card">
        <view class="bell-wrap">
          <view class="bell push-bell">
            <view class="bell-svg ico-megaphone"></view>
          </view>
          <view class="red-dot" wx:if="{{!item.read}}"></view>
        </view>
        <view class="msg-body">
          <view class="msg-head">
            <view class="msg-title">{{item.title}}</view>
            <view class="msg-time">{{item.time}}</view>
          </view>
          <view class="msg-content">{{item.content}}</view>
        </view>
      </view>
    </block>
    <view wx:if="{{pushList.length === 0}}" class="empty">暂无推送通知</view>
  </scroll-view>
</view>
