<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/iot_bg_bottom_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="#E0E4EC" />

    <TextView
        android:id="@+id/iot_tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="6dp"
        android:textColor="#15161A"
        android:textSize="19sp"
        android:textStyle="bold"
        android:letterSpacing="0.01" />

    <TextView
        android:id="@+id/iot_tvInputHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp"
        android:textColor="#9DA3B0"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/iot_etInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/iot_bg_dialog_input"
        android:paddingHorizontal="18dp"
        android:textColor="#15161A"
        android:textColorHint="#B0B7C3"
        android:textSize="15sp"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionDone" />

    <TextView
        android:id="@+id/iot_btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/iot_bg_primary_button"
        android:gravity="center"
        android:text="@string/iot_btn_confirm"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/iot_btnConfirm2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/iot_bg_outline_button"
        android:gravity="center"
        android:text="@string/iot_member_invite_as_admin"
        android:textColor="#006EFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/iot_btnCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/iot_bg_cancel_button"
        android:gravity="center"
        android:text="@string/iot_btn_cancel"
        android:textColor="#6B7280"
        android:textSize="16sp" />

</LinearLayout>
