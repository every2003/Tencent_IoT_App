<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:background="@drawable/iot_bg_menu_item_ripple">

    <FrameLayout
        android:id="@+id/iot_flItemIconBg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/iot_bg_menu_icon">

        <TextView
            android:id="@+id/iot_tvItemIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="17sp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iot_tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#15161A"
            android:textSize="15sp"
            android:letterSpacing="0.005"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/iot_tvItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9DA3B0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/iot_tvItemMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⋯"
        android:textColor="#9DA3B0"
        android:textSize="18sp"
        android:background="@drawable/iot_bg_menu_item_ripple" />

</LinearLayout>
