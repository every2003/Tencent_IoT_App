<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/iot_bg_device_card_new"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp">

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/iot_bg_device_icon_new" />

        <ImageView
            android:id="@+id/iot_iv_msg_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/iot_message_icon"
            android:src="@drawable/iot_ic_bell"
            android:tint="#006EFF" />

        <View
            android:id="@+id/iot_v_unread_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:background="@drawable/iot_bg_status_online"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/iot_tv_msg_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/iot_message_title_placeholder"
                android:textColor="#15161A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/iot_tv_msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="10:30"
                android:textColor="#9DA3B0"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/iot_tv_msg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/iot_message_content_placeholder"
            android:textColor="#6B7280"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
