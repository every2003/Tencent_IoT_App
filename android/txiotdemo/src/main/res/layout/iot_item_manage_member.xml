<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/iot_bg_device_card_new"
    android:elevation="3dp"
    android:outlineSpotShadowColor="#44000000"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/iot_flAvatarBg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/iot_bg_menu_icon">

        <TextView
            android:id="@+id/iot_tvMemberAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#006EFF"
            android:textSize="18sp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/iot_tvMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#15161A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/iot_tvMemberRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/iot_bg_badge_primary"
                android:paddingHorizontal="6dp"
                android:text="@string/iot_member_role_admin"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/iot_tvMemberSelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:background="@drawable/iot_bg_badge_warning"
                android:text="@string/iot_me"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/iot_tvMemberId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9DA3B0"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/iot_btnDeleteMember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/iot_bg_btn_danger_outline_small"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/iot_btn_delete"
        android:textColor="#FF4444"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/iot_btnLeaveFamily"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/iot_bg_btn_danger_outline_small"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/iot_exit"
        android:textColor="#FF4444"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
