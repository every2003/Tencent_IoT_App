<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/iot_bg_device_card_new"
    android:elevation="3dp"
    android:outlineSpotShadowColor="#44000000"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/iot_bg_menu_icon">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📹"
            android:textSize="18sp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iot_tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#15161A"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/iot_tvSharedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:textColor="#9DA3B0"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/iot_btnDeviceMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/iot_bg_menu_item_ripple"
        android:contentDescription="@string/iot_more_actions"
        android:padding="6dp"
        android:src="@drawable/iot_ic_more_vert"
        android:tint="#9DA3B0" />

</LinearLayout>
