<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13dp"
    android:background="@drawable/iot_bg_device_card_new"
    android:elevation="3dp"
    android:outlineSpotShadowColor="#44000000"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/iot_bg_device_icon_new" />
            <ImageView
                android:id="@+id/iot_iv_device_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/iot_ic_camera_device"
                app:tint="#006EFF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iot_tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#15161A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="智能摄像头" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/iot_indicator_status"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/iot_bg_status_online" />

                <TextView
                    android:id="@+id/iot_tv_device_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#9DA3B0"
                    android:textSize="12sp"
                    tools:text="在线" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/iot_btn_device_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iot_more_actions"
            android:padding="7dp"
            android:src="@drawable/iot_ic_more_vert"
            android:tint="#C8CDD8" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="#F2F4F8" />

    <TextView
        android:id="@+id/iot_tv_pid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C8CDD8"
        android:textSize="11sp"
        tools:text="PID: XXXXXXXXXXX" />

</LinearLayout>
