<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F8"
    android:orientation="vertical"
    tools:context=".activity.LampDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/iot_bg_toolbar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="36dp">

        <ImageButton
            android:id="@+id/iot_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iot_back"
            android:src="@drawable/iot_icon_back"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/iot_tv_lamp_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="客厅吸顶灯" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/iot_bg_lamp_status_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:id="@+id/iot_indicator_status"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/iot_bg_status_offline" />

            <TextView
                android:id="@+id/iot_tv_device_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/iot_device_status_offline"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/iot_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <ProgressBar
                    android:id="@+id/iot_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/iot_card_power"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/iot_bg_device_card_new"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#1F000000"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <View
                            android:id="@+id/iot_power_icon_bg"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/iot_bg_lamp_power_off" />

                        <ImageView
                            android:id="@+id/iot_power_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/iot_lamp_power"
                            android:src="@drawable/iot_ic_lamp_device"
                            app:tint="#9DA3B0" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/iot_lamp_power"
                            android:textColor="#15161A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/iot_tv_power_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/iot_lamp_state_off"
                            android:textColor="#9DA3B0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/iot_switch_power"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/iot_color_lamp_switch_thumb"
                        app:trackTint="@color/iot_color_lamp_switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/iot_card_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/iot_bg_device_card_new"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#1F000000"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/iot_lamp_brightness"
                            android:src="@drawable/iot_ic_lamp_brightness" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/iot_lamp_brightness"
                            android:textColor="#15161A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/iot_seek_brightness"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="99"
                            android:progress="79"
                            android:progressTint="#006EFF"
                            android:thumbTint="#006EFF" />

                        <TextView
                            android:id="@+id/iot_tv_brightness_value"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="end"
                            android:textColor="#15161A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="80%" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/iot_card_color_temp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/iot_bg_device_card_new"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#1F000000"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/iot_lamp_color_temp"
                            android:src="@drawable/iot_ic_lamp_colortemp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/iot_lamp_color_temp"
                            android:textColor="#15161A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/iot_seek_color_temp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="38"
                            android:progress="13"
                            android:progressTint="#006EFF"
                            android:thumbTint="#006EFF" />

                        <TextView
                            android:id="@+id/iot_tv_color_temp_value"
                            android:layout_width="56dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="end"
                            android:textColor="#15161A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="4000K" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/iot_card_scene"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/iot_bg_device_card_new"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#1F000000"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/iot_lamp_scene_mode"
                            android:src="@drawable/iot_ic_lamp_scene" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/iot_lamp_scene_mode"
                            android:textColor="#15161A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/iot_chip_mode_0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/iot_bg_lamp_mode_unselected"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:id="@+id/iot_iv_mode_0"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/iot_lamp_mode_manual"
                                android:src="@drawable/iot_ic_lamp_mode_manual" />

                            <TextView
                                android:id="@+id/iot_tv_mode_0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/iot_lamp_mode_manual"
                                android:textColor="#15161A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/iot_chip_mode_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="5dp"
                            android:background="@drawable/iot_bg_lamp_mode_unselected"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:id="@+id/iot_iv_mode_1"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/iot_lamp_mode_reading"
                                android:src="@drawable/iot_ic_lamp_mode_reading" />

                            <TextView
                                android:id="@+id/iot_tv_mode_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/iot_lamp_mode_reading"
                                android:textColor="#15161A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/iot_chip_mode_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="5dp"
                            android:background="@drawable/iot_bg_lamp_mode_unselected"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:id="@+id/iot_iv_mode_2"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/iot_lamp_mode_leisure"
                                android:src="@drawable/iot_ic_lamp_mode_leisure" />

                            <TextView
                                android:id="@+id/iot_tv_mode_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/iot_lamp_mode_leisure"
                                android:textColor="#15161A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/iot_chip_mode_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/iot_bg_lamp_mode_unselected"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:id="@+id/iot_iv_mode_3"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/iot_lamp_mode_night_light"
                                android:src="@drawable/iot_ic_lamp_mode_night" />

                            <TextView
                                android:id="@+id/iot_tv_mode_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/iot_lamp_mode_night_light"
                                android:textColor="#15161A"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
