<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/iot_topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/iot_bg_toolbar_gradient"
        android:paddingHorizontal="8dp"
        android:paddingTop="36dp" >

        <ImageButton
            android:id="@+id/iot_btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iot_back"
            android:padding="10dp"
            android:src="@drawable/iot_icon_back"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/iot_titleColumn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iot_btnRefresh"
            app:layout_constraintStart_toEndOf="@+id/iot_btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/iot_titleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/iot_statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/iot_bg_cloud_online_dot" />

                <TextView
                    android:id="@+id/iot_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/iot_cloud_device_name_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/iot_tvOnlineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="在线" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/iot_deviceInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iot_tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    tools:text="LKSXAVSEZV/trtc_test_eagle3" />

                <TextView
                    android:id="@+id/iot_btnChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/iot_bg_cloud_channel_chip"
                    android:drawableEnd="@drawable/iot_ic_arrow_down_small"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="#006EFF"
                    android:textSize="10sp"
                    tools:text="通道 0" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/iot_btnRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iot_refresh"
            android:padding="10dp"
            android:src="@drawable/iot_ic_refresh"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/iot_videoContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000"
        android:visibility="visible">

        <TextureView
            android:id="@+id/iot_videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ProgressBar
            android:id="@+id/iot_videoLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/iot_btnPlayPause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/iot_bg_video_float_btn"
            android:contentDescription="@string/iot_play_pause"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/iot_ic_video_pause"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/iot_replayOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/iot_btnReplay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/iot_bg_video_float_btn"
                android:contentDescription="@string/iot_cloud_replay"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/iot_ic_refresh"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/iot_tvReplayEndLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/iot_cloud_play_end_label"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/iot_playerFloatControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/iot_btnMute"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/iot_bg_video_float_btn"
                android:contentDescription="@string/iot_mute"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/iot_ic_sound_off"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/iot_btnFullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/iot_bg_video_float_btn"
                android:contentDescription="@string/iot_detail_fullscreen"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/iot_ic_video_fullscreen_enter"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/iot_snapshotPreviewLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iot_ivSnapshotPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/iot_snapshotLoading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/iot_tvSnapshotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                tools:text="人脸识别抓拍 · 08:00:00" />

            <TextView
                android:id="@+id/iot_btnSnapshotClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/iot_close"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/iot_dateScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F6FA"
        android:paddingHorizontal="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="3dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/iot_llDateList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/iot_timelineContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingTop="10dp" >

        <HorizontalScrollView
            android:id="@+id/iot_timelineScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:layout_margin="8dp">

            <com.tencent.iot.txiotdemo.view.CloudStorageTimelineView
                android:id="@+id/iot_timelineView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/iot_tvTimelineTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/iot_cloud_no_fullday_record"
            android:textColor="#9DA3B0"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/iot_timelineCenterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/iot_timelineCenterLine"
                android:layout_width="2dp"
                android:layout_height="40dp"
                android:background="#00C160" />

            <TextView
                android:id="@+id/iot_tvTimelineCenterTime"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:background="#00C160"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/iot_eventListContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iot_rvEventList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/iot_item_cloud_storage_event" />

        <LinearLayout
            android:id="@+id/iot_emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iot_cloud_empty"
                android:textColor="#9DA3B0"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/iot_listLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
