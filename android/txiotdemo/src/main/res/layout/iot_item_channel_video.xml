<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:background="@drawable/iot_channel_item_background"
    android:layout_margin="4dp">

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/iot_channelVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/iot_channelLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/iot_channelLoadingProgressBar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/iot_tvChannelLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="6dp"
        android:background="#66000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</FrameLayout>
