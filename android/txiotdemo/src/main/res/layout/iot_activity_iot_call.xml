<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/iot_root_call"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1A18"
    android:keepScreenOn="true">

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/iot_video_remote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/iot_video_local"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/iot_layout_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/iot_container_avatar"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/iot_bg_call_avatar_square">

            <ImageView
                android:id="@+id/iot_iv_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/iot_ic_camera_device"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/iot_tv_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            tools:text="蜡笔小新520" />

    </LinearLayout>

    <TextView
        android:id="@+id/iot_tv_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="260dp"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        tools:text="等待对方接受邀请." />

    <TextView
        android:id="@+id/iot_tv_call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="236dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="00:12"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <LinearLayout
            android:id="@+id/iot_layout_row_video_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iot_btn_mic_video"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/iot_bg_call_btn_white"
                    android:padding="16dp"
                    android:src="@drawable/iot_ic_mic_on"
                    app:tint="#111111" />

                <TextView
                    android:id="@+id/iot_tv_mic_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/iot_call_mic_on"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iot_btn_speaker_video"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/iot_bg_call_btn_white"
                    android:padding="16dp"
                    android:src="@drawable/iot_ic_speaker_on"
                    app:tint="#111111" />

                <TextView
                    android:id="@+id/iot_tv_speaker_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/iot_call_speaker_on"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iot_btn_camera"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/iot_bg_call_btn_white"
                    android:padding="16dp"
                    android:src="@drawable/iot_ic_video_camera"
                    app:tint="#111111" />

                <TextView
                    android:id="@+id/iot_tv_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/iot_call_camera_on"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/iot_layout_row_video_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1">
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/iot_btn_hangup_video"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/iot_bg_call_hangup_circle"
                    android:padding="18dp"
                    android:rotation="135"
                    android:src="@drawable/iot_ic_call"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/iot_btn_switch_camera"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/iot_ic_call_camera_flip"
                    app:tint="#FFFFFF" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/iot_layout_row_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iot_btn_mic_audio"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/iot_bg_call_btn_white"
                    android:padding="17dp"
                    android:src="@drawable/iot_ic_mic_on"
                    app:tint="#111111" />

                <TextView
                    android:id="@+id/iot_tv_mic_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/iot_call_mic_on"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iot_btn_hangup_audio"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/iot_bg_call_hangup_circle"
                    android:padding="17dp"
                    android:rotation="135"
                    android:src="@drawable/iot_ic_call"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/iot_tv_hangup_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/iot_btn_cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iot_btn_speaker_audio"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/iot_bg_call_btn_gray"
                    android:padding="17dp"
                    android:src="@drawable/iot_ic_speaker_off"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/iot_tv_speaker_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/iot_call_speaker_off"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/iot_layout_accept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iot_btn_accept"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/iot_bg_call_accept_circle"
                android:padding="18dp"
                android:src="@drawable/iot_ic_call"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/iot_call_answer"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
