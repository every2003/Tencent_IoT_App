<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/iot_bg_bottom_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="#E0E4EC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iot_share_device_menu"
            android:textColor="#15161A"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/iot_tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9DA3B0"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="14dp"
        android:background="#ECEEF2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/iot_share_target_user_label"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/iot_etUserId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/iot_bg_dialog_input"
        android:hint="@string/iot_share_target_user_hint"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:textColor="#15161A"
        android:textColorHint="#B0B7C3"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/iot_btnConfirmShare"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/iot_bg_primary_button"
        android:gravity="center"
        android:text="@string/iot_share_now"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/iot_btnViewSharedUsers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/iot_bg_outline_button"
        android:gravity="center"
        android:text="@string/iot_share_menu_shared_users"
        android:textColor="#006EFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/iot_btnCancelShare"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/iot_bg_cancel_button"
        android:gravity="center"
        android:text="@string/iot_btn_cancel"
        android:textColor="#6B7280"
        android:textSize="16sp" />

</LinearLayout>
