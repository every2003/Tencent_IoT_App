<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="4">

    <FrameLayout
        android:id="@+id/iot_channel_item_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iot_tv_channel_circle_0"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/iot_bg_channel_circle_selected"
                android:gravity="center"
                android:text="@string/iot_channel_0"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/iot_tv_channel_label_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/iot_channel_0"
                android:textColor="#1890ff"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/iot_channel_item_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iot_tv_channel_circle_1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/iot_bg_channel_circle_unselected"
                android:gravity="center"
                android:text="@string/iot_channel_1"
                android:textColor="#15161A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/iot_tv_channel_label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/iot_channel_1"
                android:textColor="#9DA3B0"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/iot_channel_item_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iot_tv_channel_circle_2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/iot_bg_channel_circle_unselected"
                android:gravity="center"
                android:text="@string/iot_channel_2"
                android:textColor="#15161A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/iot_tv_channel_label_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/iot_channel_2"
                android:textColor="#9DA3B0"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/iot_channel_item_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iot_tv_channel_circle_3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/iot_bg_channel_circle_unselected"
                android:gravity="center"
                android:text="@string/iot_channel_3"
                android:textColor="#15161A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/iot_tv_channel_label_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/iot_channel_3"
                android:textColor="#9DA3B0"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
