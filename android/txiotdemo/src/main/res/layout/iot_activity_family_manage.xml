<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/iot_bg_toolbar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="36dp"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/iot_btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iot_back"
            android:src="@drawable/iot_icon_back"
            android:tint="@color/iot_white" />

        <TextView
            android:id="@+id/iot_tvFamilyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/iot_loading"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/iot_btnFamilyMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iot_more_actions"
            android:src="@drawable/iot_ic_more_vert"
            android:tint="@color/iot_white" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#ECEEF2" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/iot_tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        app:tabGravity="fill"
        app:tabIndicatorColor="#006EFF"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="#1A006EFF"
        app:tabSelectedTextColor="#006EFF"
        app:tabTextAppearance="@style/iot_SubTabTextAppearance"
        app:tabTextColor="#99000000"
        app:tabUnboundedRipple="false">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/iot_member_management" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/iot_room_manage_title" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/iot_device_list" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/iot_shared_to_me" />

    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#ECEEF2" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/iot_viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
