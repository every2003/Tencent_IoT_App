<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="iot_Theme.Android" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">#1A73E8</item>
        <item name="colorPrimaryVariant">#1558B0</item>
        <item name="colorOnPrimary">@color/iot_white</item>

        <item name="colorSecondary">@color/iot_teal_200</item>
        <item name="colorSecondaryVariant">@color/iot_teal_700</item>
        <item name="colorOnSecondary">@color/iot_black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

    </style>

    <style name="iot_BottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/iot_BottomSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="iot_BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/iot_BottomSheetShapeAppearance</item>
        <item name="backgroundTint">@android:color/white</item>
    </style>

    <style name="iot_BottomSheetShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="iot_TopTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="iot_SubTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="iot_ManageTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="textAllCaps">false</item>
    </style>

</resources>
