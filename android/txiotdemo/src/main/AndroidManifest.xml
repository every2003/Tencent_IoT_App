<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/iot_ic_launcher"
        android:label="@string/iot_app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/iot_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/iot_Theme.Android">

        <activity android:name=".activity.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activity.DeviceListActivity" />
        <activity android:name=".activity.LampDetailActivity" />
        <activity android:name=".activity.FamilyManageActivity" />
        <activity
            android:name=".activity.DeviceDetailActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".activity.AddDeviceActivity" />
        <activity android:name=".activity.MessageActivity" />
        <activity android:name=".activity.PersonalInfoActivity" />
        <activity
            android:name=".activity.CloudStorageActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:screenOrientation="portrait" />
        <activity android:name=".activity.DebugSettingsActivity" />
        <activity
            android:name=".activity.QRCodeScannerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activity.IoTCallActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:theme="@style/iot_Theme.Android" />

    </application>

</manifest>
